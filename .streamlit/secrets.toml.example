# 复制本文件为 .streamlit/secrets.toml 后填入自己的值。
# secrets.toml 已被 .gitignore 忽略, 不会被提交。
#
# 优先用环境变量也可以(免建文件):
#   export LLM_BASE=https://api.openai.com/v1
#   export LLM_KEY=sk-...
#   export LLM_MODEL=gpt-4o-mini

# 网关地址: 任意 OpenAI 兼容网关, 会请求 {base}/chat/completions
llm_base = "https://api.openai.com/v1"

# API Key(必填)
llm_key = "sk-your-api-key"

# 模型标识(必填): 需要支持 function calling / tool use, 索引与多步检索都依赖它
llm_model = "gpt-4o-mini"
